# Server (used by server-lib/, both local `npm run dev:api` and the Vercel function read these)
PORT=4000
NODE_ENV=development

# Only matters for cross-origin requests. Frontend and API now share one origin in both
# local dev (via the Vite proxy) and production (same Vercel deployment), so this is a
# defensive default rather than something you need to keep in sync. Safe to leave as-is
# unless you're calling the API from somewhere else entirely.
CLIENT_ORIGIN=http://localhost:5173

# Database. On Vercel this MUST be a pooled connection string (PgBouncer), not a direct
# one. On Neon, copy the connection string with "-pooler" in the hostname. See the comment
# in server-lib/config/database.ts for why. Local dev / non-serverless hosts: either works.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reelforge

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google sign in. Client ID and secret come from Google Cloud Console > APIs & Services >
# Credentials > OAuth Client ID (Web application type). GOOGLE_CALLBACK_URL must exactly
# match one of the Authorized redirect URIs configured on that credential.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Nano Banana (Gemini image generation), the premium image tier. A different Google
# credential from the OAuth client above, this one is a Gemini API key from Google AI
# Studio, aistudio.google.com then Get API key. Paid usage requires billing enabled on
# that Google Cloud project.
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# AI providers
# Default setup needs ONLY NVIDIA_API_KEY below. Script generation, images, and voice all
# run on NVIDIA's free build.nvidia.com catalog by default. Groq is registered as an
# alternative script provider but isn't required; only fill this in if you want to switch
# to it later (see server-lib/providers/registry.ts to change the default).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

NVIDIA_API_KEY=
NVIDIA_FLUX_MODEL=black-forest-labs/flux.1-schnell
NVIDIA_CHATTERBOX_MODEL=nvidia/chatterbox-tts
# Free tier (everyone) vs. Premium tier (active trial or paid subscription). Both run on
# the same NVIDIA_API_KEY, just different model strings. See server-lib/services/
# subscriptionService.ts for how a user's plan picks between them.
NVIDIA_SCRIPT_MODEL_FREE=nvidia/nemotron-3-super-120b-a12b
NVIDIA_SCRIPT_MODEL_PREMIUM=deepseek-ai/deepseek-v4-pro

# Billing (Paystack). dashboard.paystack.com, Settings then API Keys and Webhooks for the key
# pair, and Settings then Plans for PAYSTACK_PLAN_CODE (create a plan there first). Also set
# your webhook URL in that same settings page to: <your-domain>/api/billing/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_CODE=
# Main-unit price (not kobo/cents. The code converts). Confirm your Paystack account is
# enabled for the currency you set here; NGN works by default, USD needs verification.
PAYSTACK_AMOUNT=10
PAYSTACK_CURRENCY=NGN

# Storage. Set STORAGE_DRIVER to "s3" or "cloudinary"
STORAGE_DRIVER=s3

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
